{
  "format": "serenox.plugin.package/v1",
  "id": "profile.clock",
  "name": "Profile Clock",
  "version": "1.0.0",
  "description": "Displays the original profile name followed by the local time",
  "category": "go-executable",
  "protocol": {"min": "1.0", "max_exclusive": "2.0"},
  "core": {"min": "0.1.0", "max_exclusive": "1.0.0"},
  "entrypoints": [{"os": "linux", "arch": "amd64", "path": "bin/profile-clock"}],
  "capabilities": ["commands", "storage", "client.identity.read", "telegram.profile", "jobs"],
  "permissions": ["storage.read", "storage.write", "telegram.reply", "client.identity.read", "telegram.profile.write", "jobs.schedule"],
  "files": []
}

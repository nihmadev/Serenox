{
  "format": "serenox.plugin.package/v1",
  "id": "example.weather_python",
  "name": "Weather Python",
  "version": "1.0.0",
  "description": "Read-only weather lookup through host HTTP",
  "category": "python-sidecar",
  "protocol": {"min": "1.0", "max_exclusive": "2.0"},
  "core": {"min": "0.1.0", "max_exclusive": "1.0.0"},
  "sdk": {"min": "0.1.0", "max_exclusive": "1.0.0"},
  "sidecar": {"min": "0.1.0", "max_exclusive": "1.0.0"},
  "entrypoints": [{"os": "any", "arch": "any", "path": "plugin.py", "module": "plugin.py", "class": "Weather"}],
  "capabilities": ["commands", "http"],
  "permissions": ["telegram.reply", "network.http.read"],
  "network": {
    "origins": [
      {"scheme": "https", "host": "api.open-meteo.com", "name": "open-meteo"},
      {"scheme": "https", "host": "geocoding-api.open-meteo.com", "name": "open-meteo-geocoding"}
    ],
    "max_response_bytes": 65536,
    "max_redirects": 0,
    "request_timeout_ms": 10000,
    "max_concurrent": 2,
    "requests_per_second": 0.2,
    "burst": 2
  },
  "files": []
}
